# ==============================================================================
# BIZPRO+ PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Copy this file to .env.production and supply real cryptographically secure secrets.
# NEVER COMMIT REAL PRODUCTION SECRETS INTO VERSION CONTROL.
# ==============================================================================

# Database Configuration
POSTGRES_DB=bizpro_db
POSTGRES_USER=bizpro_app
POSTGRES_PASSWORD=replace_with_strong_production_db_password_min32ch!
DATABASE_URL=postgresql://bizpro_app:replace_with_strong_production_db_password_min32ch!@postgres:5432/bizpro_db?schema=public

# Security Secrets (Must be at least 32 characters, 256-bit entropy)
JWT_ACCESS_SECRET=replace_with_strong_jwt_access_secret_production_32chars!
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_production_32chars!
AUTH_RESPONSE_ENVELOPE_KEY=replace_with_strong_envelope_secret_production_32ch!

# Application Configuration
FRONTEND_URL=http://localhost
NEXT_PUBLIC_API_URL=/api/v1
ENABLE_SWAGGER=false
