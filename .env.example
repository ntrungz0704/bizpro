# ===================================================
# BIZPRO+ ENVIRONMENT CONFIGURATION (TEMPLATE)
# ===================================================

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=bizpro_user
DB_PASSWORD=bizpro_password
DB_NAME=bizpro_db
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Authentication Secrets (Generate strong 32+ byte strings in production)
JWT_ACCESS_SECRET="bizpro_access_secret_super_secure_key_change_in_production"
JWT_REFRESH_SECRET="bizpro_refresh_secret_super_secure_key_change_in_production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"
