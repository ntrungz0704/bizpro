# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Security (Required for Phase 1D)
JWT_ACCESS_SECRET=bizpro_access_secret_super_secure_key_change_in_production_32bytes
JWT_REFRESH_SECRET=bizpro_refresh_secret_super_secure_key_change_in_production_32bytes
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database (Required for Phase 1C)
DATABASE_URL="postgresql://bizpro_user:bizpro_password@localhost:5432/bizpro_db?schema=public"
